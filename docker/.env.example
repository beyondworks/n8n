# ============================================
# 🚀 n8n 환경 변수 설정
# ============================================
# 이 파일을 .env로 복사하고 필요한 값을 수정하세요
# cp .env.example .env
# ============================================

# ========================================
# 🌐 외부 접속 설정
# ========================================
# Cloudflare Tunnel 사용 시 false (권장)
# n8n 내장 터널 사용 시 true
N8N_TUNNEL_MODE=false

# Webhook URL (Cloudflare Tunnel 도메인)
# 예: https://n8n.yourdomain.com
WEBHOOK_URL=

# ========================================
# 🔒 보안 설정 (선택사항)
# ========================================
# 외부 공개 시 비밀번호 설정 권장
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password

# ========================================
# 🔑 API Keys (워크플로우에 필요한 경우만)
# ========================================

# Perplexity API - https://www.perplexity.ai/
PERPLEXITY_API_KEY=

# Notion API - https://www.notion.so/my-integrations
NOTION_API_KEY=

# OpenAI API (선택) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Slack Bot Token (선택) - https://api.slack.com/apps
SLACK_BOT_TOKEN=

# ========================================
# 🤖 MCP 서버 설정 (Universal Assistant)
# ========================================
# Notion MCP Server 내부 인증 토큰 (임의 문자열로 변경)
MCP_AUTH_TOKEN=change_this_to_random_token

# ========================================
# 🛡️ Slack 보안 설정
# ========================================
# 허가된 Slack 사용자 ID (쉼표 구분)
# Slack에서 프로필 > 더보기 > 멤버 ID 복사
ALLOWED_SLACK_USERS=

# ========================================
# 🧠 AI Assistant 설정
# ========================================
# AI 제공자 (openai 또는 gemini)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Gemini API (fallback용) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ========================================
# ⏰ 시간대 설정
# ========================================
GENERIC_TIMEZONE=Asia/Seoul
